# Copy this file to .env in the project folder and fill in the real values.
# On PythonAnywhere the .env file lives next to bot.py, so ~/Cinema_Kingdom/.env
# Never commit .env - it holds your bot token.

# ---------- Telegram ----------
BOT_TOKEN=123456:ABC-your-bot-token
BOT_USERNAME=Cinema_Valut_bot

# Leave these blank to keep the defaults already in config.py
SUPER_ADMIN_ID=8946393148
ADMIN_IDS=
GROUP_ID=-1004495714945
CHANNEL_ID=-1004479223164
STORAGE_CHANNEL=-1003272548510
GROUP_USERNAME=cinema_kingdom_vault1
CHANNEL_USERNAME=Cinema_Kingdom_Vault
STORAGE_USERNAME=mystoragecinema
# Names printed in the group welcome message and on the delivered file.
GROUP_NAME=Cinema Kingdom 3.0
CHANNEL_NAME=Cinema Kingdom Community
# Your own @username (no @). Used as the super admin contact in the group
# welcome message. Leave blank and the line disappears.
SUPER_ADMIN_USERNAME=

# ---------- Webhook (PythonAnywhere) ----------
# Site address only, no path and no trailing slash.
WEBHOOK_BASE_URL=https://yourusername.pythonanywhere.com
# Create with: python setup_hook.py --make-secret
# The same string is reused as the X-Keep-Alive-Token header for /tick,
# so put it in the GitHub repository secret KEEP_ALIVE_TOKEN too.
WEBHOOK_SECRET_TOKEN=

# ---------- Google Sheet ----------
GOOGLE_SHEET_URL=
# Either a file name in the project folder...
GOOGLE_CREDENTIALS_FILE=credentials.json
# ...or the whole service account JSON, base64 encoded (recommended).
GOOGLE_CREDENTIALS_BASE64=
GOOGLE_CREDENTIALS_JSON=

# ---------- Ad-link shortener (GPLinks / Shrinkme) ----------
# Both services are the same platform and answer with the same JSON shape, so
# switching is just this URL plus the key from your own dashboard.
# https://api.gplinks.com/api  and  https://shrinkme.io/api
# With an empty key the bot refuses to send any movie file, so no ad is skipped.
SHORTENER_API_KEY=
SHORTENER_BASE_URL=https://shrinkme.io/api
SHORTENER_ALIAS=
SHORTENER_RESPONSE_FORMAT=json

# true  = users still get the movie by direct link when the ad site is
#         unreachable (PythonAnywhere free blocks shrinkme.io until it is
#         allowlisted), so that click earns nothing.
# false = the download is refused instead: no ad, no file.
ALLOW_DIRECT_LINK=true

# ---------- Storage and timing ----------
# Plain "bot.db" keeps the database inside the project folder, which is
# persistent on PythonAnywhere.
DB_PATH=bot.db
AUTO_DELETE_TIME=300
# true = the 5 minute sweep also deletes messages the bot sent to admins
# (pending request lists would vanish before a Solved button can be pressed).
# MyStorage posts are NEVER deleted, whatever this says.
DELETE_ADMIN_MESSAGES=false
COOLDOWN_TIME=60
# Seconds a member must wait between messages in the group, admins included
# (commands are exempt). 0 = off.
GROUP_MESSAGE_INTERVAL=60
# true = any file, video, music, photo or sticker a member sends in the group is
# deleted and the sender removed. Admins are exempt so they can post posters.
GROUP_BLOCK_ATTACHMENTS=true
# Violations inside the window below before the member is banned instead of
# only removed. 1 = ban at the first violation.
GROUP_BAN_STRIKES=2
# Seconds a violation keeps counting towards the next one (default 1 day).
GROUP_OFFENCE_WINDOW=86400
MAX_MOVIES_PER_SEARCH=15
# Movie buttons shown on each search result page.
SEARCH_RESULTS_PER_PAGE=5
LINK_EXPIRE_TIME=300
AUTO_FILE_DELAY=5
SHEET_SYNC_INTERVAL=60
PROMO_INTERVAL=3600
# How often the pending movie request list is DM'd to every admin.
REQUEST_REMINDER_INTERVAL=3600
# How often joined members are appended to the Group Members worksheet.
MEMBER_SHEET_INTERVAL=3600
LOCAL_TIMEZONE=Asia/Kolkata

# ---------- Messages ----------
# The one line printed on every delivered movie file, above the group links.
FILE_CAPTION_NOTE=📝 Daily movie uploads and requests in our group. Join and stay tuned!

# ---------- tick.py only ----------
# How long each scheduled run stays awake, in minutes. Keep below 60.
TICK_RUN_MINUTES=55
